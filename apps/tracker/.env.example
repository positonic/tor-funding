# Example environment for the donation tracker.
# Copy to .env (gitignored at the repo root) and fill in values for local dev.
# In production, these come from TPA secret store / GitLab CI vars.

# --- Third-party API keys ---
# Historical USD prices. Free tier works for sparse 5-min-rounded lookups.
COINGECKO_API_KEY=

# EVM RPC (Ethereum, Arbitrum, Base, Optimism) — spec §9.2.
ALCHEMY_API_KEY=

# Solana RPC — spec §9.3.
HELIUS_API_KEY=

# --- Tracker behavior ---
# Where `generate.ts` writes the atomic snapshot. Default: ./out/snapshot.json
SNAPSHOT_OUTPUT_PATH=./out/snapshot.json

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Admin/diagnostics HTTP port (spec §14.3). Internal-only.
ADMIN_PORT=8080

# SQLite database path (relative to apps/tracker/).
DATABASE_PATH=./data/tor-campaign.sqlite

# Repo-root-relative paths to source-of-truth configs (spec §14.1).
PROJECTS_CONFIG_PATH=../../config/projects.yaml
MATCHING_POOL_CONFIG_PATH=../../config/matching-pool.yaml

# --- View-key secrets (never commit real values) ---
#
# Secret refs in config YAML look like:
#   vault://kv/tor-campaign/xmr/anti-censorship/view_key
#
# The local-dev store (src/secrets/store.ts) maps this to an env var of the
# form TOR_SECRETS_<UPPER_SNAKE_CASE_OF_PATH_AFTER_TOR_CAMPAIGN>:
#
#   vault://kv/tor-campaign/xmr/anti-censorship/view_key
#     -> TOR_SECRETS_XMR_ANTI_CENSORSHIP_VIEW_KEY
#
# NEVER commit real view keys. NEVER log values. See CLAUDE.md contract §3.

# TOR_SECRETS_XMR_ANTI_CENSORSHIP_VIEW_KEY=
# TOR_SECRETS_XMR_ARTI_VIEW_KEY=
# TOR_SECRETS_XMR_MATCHING_POOL_VIEW_KEY=
