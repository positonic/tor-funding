{
  "name": "@tor/tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Donation tracker for the Tor × FtC QF campaign. Watches a known set of recipient addresses across supported chains, stores observed donations in SQLite, and regenerates snapshot.json every 60s.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tor/types": "*",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
